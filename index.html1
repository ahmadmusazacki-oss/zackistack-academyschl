<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Zacki Stackfix Academy</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f5f9;color:#202532;line-height:1.6}header{background:#101b35;color:#fff;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}header h2{color:#d4af37;margin:0;font-size:19px}nav{display:flex;flex-wrap:wrap;gap:4px}nav button{background:none;border:0;color:#fff;padding:9px;cursor:pointer;font-weight:bold}.hero{background:#101b35;color:white;text-align:center;padding:52px 16px}.hero h1{color:#d4af37}.container{max-width:1100px;margin:auto;padding:18px}.card{background:#fff;padding:20px;border-radius:10px;margin:14px 0;box-shadow:0 2px 10px #0001}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}input,select,textarea{width:100%;padding:11px;margin:6px 0 14px;border:1px solid #ccd1dc;border-radius:6px;font-size:15px}label{font-weight:bold}button.action{background:#101b35;color:white;padding:10px 15px;border:0;border-radius:6px;cursor:pointer;margin:4px}button.gold{background:#b18a17}.hidden{display:none!important}.notice{padding:11px;margin:12px 0;background:#fff3cd;border-radius:6px}.success{background:#d1e7dd;color:#0f5132}.error{background:#f8d7da;color:#842029}.course-card{border-top:4px solid #d4af37}.badge{display:inline-block;background:#f4e6b4;color:#453500;padding:3px 9px;border-radius:20px;font-size:12px}.lesson-list{display:grid;gap:9px}.lesson-button{width:100%;text-align:left;padding:13px;background:white;border:1px solid #ddd;border-radius:7px;cursor:pointer}.lesson-content{background:white;padding:22px;border-radius:9px;line-height:1.8}.exercise{background:#fff3cd;padding:14px;border-radius:8px;margin-top:18px}.small{font-size:13px;color:#687080}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:560px}th,td{border:1px solid #ddd;padding:9px;text-align:left}th{background:#101b35;color:white}footer{text-align:center;background:#101b35;color:white;padding:20px;margin-top:30px}a{overflow-wrap:anywhere}.module-btn{width:100%;text-align:left;background:#f4f6fa;border:1px solid #ddd;border-radius:6px;padding:12px;cursor:pointer}
</style>
</head>
<body>
<header><h2>ZACKI STACKFIX ACADEMY</h2><nav><button onclick="showPage('home')">Home</button><button onclick="showPage('courses')">Courses</button><button onclick="showPage('register')">Register</button><button onclick="showPage('studentLogin')">Student Login</button><button onclick="showPage('adminLogin')">Admin</button></nav></header>
<section id="home"><div class="hero"><h1>Welcome to Zacki Stackfix Academy</h1><p>Learn Technology. Build Skills. Create Smart Solutions.</p><button class="action gold" onclick="showPage('courses')">Explore Courses</button><button class="action" onclick="showPage('register')">Register Now</button></div><div class="container"><div class="card"><h2>About Our Academy</h2><p>Zacki Stackfix Academy provides practical technology training in artificial intelligence, cybersecurity, networking, cloud computing and web development.</p></div><h2>Our Courses</h2><div id="homeCourses" class="grid"></div></div></section>
<section id="courses" class="hidden"><div class="container"><h2>Our Courses</h2><p>Select a course to view its lectures.</p><div id="courseList" class="grid"></div></div></section>
<section id="courseDetails" class="hidden"><div class="container"><button class="action" onclick="showPage('courses')">← All Courses</button><div class="card"><h2 id="courseHeading"></h2><p id="courseDescription"></p><div id="lessonList" class="lesson-list"></div><button class="action gold" onclick="goRegister(currentCourse)">Apply for this course</button></div></div></section>
<section id="lessonPage" class="hidden"><div class="container"><button class="action" onclick="backToCourse()">← Back to Lessons</button><div id="lessonContent" class="lesson-content"></div><button class="action" onclick="previousLesson()">Previous Lesson</button><button class="action gold" onclick="nextLesson()">Next Lesson →</button></div></section>
<section id="register" class="hidden"><div class="container"><div class="card"><h2>Student Registration</h2><div id="registerMessage"></div><form id="registerForm"><label>Full Name</label><input id="regName" required><label>Email Address</label><input id="regEmail" type="email" required><label>Phone Number</label><input id="regPhone" required><label>Select Course</label><select id="regCourse" required><option value="">Choose a course</option><option>AI Development</option><option>Cybersecurity</option><option>Network Security</option><option>Computer Networking</option><option>Cloud Computing</option><option>Web Development</option></select><label>Create Password</label><input id="regPassword" type="password" minlength="6" required><button class="action" type="submit">Create Student Account</button></form><p class="small">Your password is securely managed by Firebase Authentication.</p></div></div></section>
<section id="studentLogin" class="hidden"><div class="container"><div class="card"><h2>Student Login</h2><div id="studentMessage"></div><form id="studentLoginForm"><label>Email Address</label><input id="studentEmail" type="email" required><label>Password</label><input id="studentPassword" type="password" required><button class="action" type="submit">Login</button></form><div id="studentProfile" class="hidden"></div></div></div></section>
<section id="adminLogin" class="hidden"><div class="container"><div class="card"><h2>Administrator Login</h2><div id="adminMessage"></div><form id="adminLoginForm"><label>Admin Email</label><input id="adminEmail" type="email" required><label>Password</label><input id="adminPassword" type="password" required><button class="action" type="submit">Admin Login</button></form></div></div></section>
<section id="dashboard" class="hidden"><div class="container"><div class="card"><h2>Administrator Dashboard</h2><p>Manage Zacki Stackfix Academy records.</p><button class="action" onclick="adminLogout()">Logout</button></div><div class="card"><h3>Dashboard Modules</h3><div id="dashboardCards" class="grid"></div></div><div class="card"><h2 id="moduleTitle">Records</h2><div id="moduleMessage"></div><div id="moduleFormArea"></div><div class="table-wrap"><table><thead id="tableHead"></thead><tbody id="tableBody"></tbody></table></div></div></div></section>
<footer><p>© 2026 Zacki Stackfix Academy. All Rights Reserved.</p><p>Technology Education • Practical Learning • Smart Solutions</p></footer>
<script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js';
import {getAuth,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js';
import {getFirestore,doc,getDoc,setDoc,collection,addDoc,getDocs,serverTimestamp,query,where} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js';
const firebaseConfig={apiKey:'AIzaSyBNHpKN8PyzlPCki83WqUBl5GIHP7vstnk',authDomain:'zacki-stackfix-academy.firebaseapp.com',projectId:'zacki-stackfix-academy',storageBucket:'zacki-stackfix-academy.firebasestorage.app',messagingSenderId:'800401275558',appId:'1:800401275558:web:9d65b9b30719a0f029d267',measurementId:'G-C77GMHRYKX'};
const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app);
const modules={students:['fullName','admissionNumber','phone','gender','dateOfBirth','parentName','parentPhone','address','status'],teachers:['fullName','teacherID','phone','email','subject','status'],departments:['departmentName','departmentCode','description','status'],programmes:['programmeName','programmeCode','department','duration','qualification','status'],courses:['courseName','courseCode','description','duration','status'],enrollments:['studentName','studentEmail','admissionNumber','course','enrollmentDate','duration','status'],results:['studentName','studentEmail','admissionNumber','course','score','grade','session','remark'],attendance:['studentName','admissionNumber','course','date','attendanceStatus'],fees:['studentName','admissionNumber','amount','paid','balance','paymentDate','status'],certificates:['studentName','admissionNumber','course','certificateNumber','issueDate','status'],announcements:['title','message','date','status'],materials:['title','course','description','resourceUrl','status']};
const curriculum={
'AI Development':{description:'Learn artificial intelligence, machine learning, prompt engineering and practical AI solutions.',lessons:[
['Introduction to Artificial Intelligence','Artificial Intelligence (AI) enables computer systems to perform tasks that normally require human intelligence. Examples include understanding language, recognizing images, making predictions and helping people solve problems.',['AI is used in education, healthcare, transport and business.','AI systems use data and algorithms.','AI supports human decisions but should be checked.'],'List five AI applications and explain what each one does.'],
['Data and Machine Learning Basics','Machine learning is a branch of AI in which computers learn patterns from data. A model is trained using examples and can then make predictions on new information.',['Data may be text, images, numbers or sound.','Training data teaches a model patterns.','Testing measures model performance.'],'Create a table of five fruits with their names, colours and shapes. Explain how this data could help a computer identify fruits.'],
['Prompt Engineering and AI Assistants','Prompt engineering means writing clear instructions for an AI system. A good prompt explains the task, gives context and describes the expected answer.',['State the task clearly.','Provide useful background information.','Specify the answer format.','Check AI output for errors.'],'Write three prompts asking an AI assistant to explain computer networking at beginner, intermediate and advanced levels.'],
['Building a Simple AI Solution','An AI project begins with a problem to solve. The developer identifies users, gathers suitable data, chooses a tool, tests the solution and improves it.',['Identify a real problem.','Plan the solution.','Build and test a prototype.','Protect user information.'],'Design a simple academy chatbot. List five questions students might ask and the answers it should provide.'],
['Responsible AI and Project Presentation','Responsible AI development considers fairness, privacy, safety and human oversight. Developers should explain system limitations and avoid using AI to mislead or harm people.',['Respect privacy.','Check outputs before relying on them.','Avoid biased applications.','Explain system limitations.'],'Prepare a one-page presentation describing an AI solution for a school and its possible risks.']]},
'Cybersecurity':{description:'Understand digital safety, cyber threats, privacy protection and ethical cybersecurity.',lessons:[
['What is Cybersecurity?','Cybersecurity protects computers, networks, applications and information from unauthorized access, damage or theft.',['Confidentiality protects information from unauthorized viewing.','Integrity protects information from improper changes.','Availability keeps systems accessible.'],'Give one example of a threat to confidentiality, integrity and availability.'],
['Online Safety and Account Protection','Online accounts can be targeted through stolen passwords, fake login pages and social engineering. Strong unique passwords and multi-factor authentication reduce risk.',['Use unique passwords.','Enable multi-factor authentication.','Never share verification codes.','Review login alerts.'],'Create a personal account-safety checklist with seven actions.'],
['Malware and Phishing Awareness','Malware is software designed to harm devices or gain unauthorized access. Phishing uses deceptive messages or websites to trick people into revealing information.',['Avoid unexpected attachments.','Check website addresses.','Install trusted security updates.','Report suspicious messages.'],'Identify five signs that an email or message may be phishing.'],
['Data Privacy and Safe Browsing','Data privacy concerns how personal information is collected, stored, shared and used. Safe browsing includes checking website security and limiting unnecessary permissions.',['Share only necessary information.','Check app permissions.','Use trusted downloads.','Keep browsers updated.'],'Review three apps and explain which permissions they actually need.'],
['Ethical Cybersecurity and Career Paths','Ethical cybersecurity protects systems with proper authorization. Professionals follow laws, respect privacy and report weaknesses responsibly.',['Get permission before testing systems.','Document findings accurately.','Protect confidential information.','Report weaknesses responsibly.'],'Write a code of conduct for a beginner cybersecurity student.']]},
'Network Security':{description:'Learn how to protect networks, manage access, understand firewalls and respond to security incidents.',lessons:[
['Introduction to Network Security','Network security protects devices, communication channels and information moving across networks. It combines policies, secure configurations, monitoring and technical controls.',['Protect network devices and information.','Use layered security controls.','Keep equipment updated.','Monitor unusual activity.'],'Draw a simple office network and identify three places where security controls should be used.'],
['Authentication, Authorization and Access Control','Authentication checks who a user is. Authorization determines what that user is allowed to do. Access control limits systems and information to approved people.',['Use individual accounts.','Apply least privilege.','Remove access when no longer needed.','Review permissions.'],'Design three user roles for a school network: administrator, teacher and student. List their access rights.'],
['Firewalls, Encryption and Secure Wi-Fi','A firewall controls network traffic according to defined rules. Encryption protects information by making it unreadable to unauthorized parties. Secure Wi-Fi uses strong authentication and encryption.',['Use appropriate firewall rules.','Use modern Wi-Fi security.','Encrypt sensitive information.','Change default router credentials.'],'Prepare a checklist for securing a small office Wi-Fi router. Do not change a live network without permission.'],
['Threats, Malware and Social Engineering','Network threats include malicious software, unauthorized access, weak passwords and deceptive communication. Social engineering manipulates people into revealing information.',['Train users to identify suspicious requests.','Apply security updates.','Use endpoint protection.','Separate important network resources.'],'Create an awareness lesson explaining how staff can recognize suspicious emails.'],
['Monitoring, Backups and Incident Response','Security monitoring helps identify unusual network behaviour. Backups support recovery after data loss, while incident response provides a structured way to handle security events.',['Record important events.','Keep protected backups.','Document incidents.','Test recovery procedures.'],'Write a simple incident response plan for a school computer laboratory.']]},
'Computer Networking':{description:'Study network fundamentals, devices, IP addressing, protocols and troubleshooting.',lessons:[
['Introduction to Computer Networking','A computer network is a group of connected devices that exchange information and share resources. Networks allow computers, phones, printers and servers to communicate.',['Networks share files and services.','Devices communicate using protocols.','Networks require hardware and configuration.'],'Draw a network connecting three computers to one printer and explain how they communicate.'],
['Types of Networks and Topologies','A LAN connects devices within a limited area such as a school or office. A WAN connects networks over larger geographical distances. Topology describes how devices are arranged.',['LAN covers a limited area.','WAN covers larger distances.','Star topology uses a central device.','Topology affects reliability.'],'Draw star, bus and ring topologies. Write one advantage and disadvantage of each.'],
['Networking Devices and Cabling','Common network devices include switches, routers, wireless access points and modems. Ethernet cables connect wired devices, while access points provide Wi-Fi.',['A switch connects devices within a LAN.','A router connects different networks.','An access point provides wireless connectivity.','Use suitable cables and connectors.'],'Identify five networking devices and describe the job of each.'],
['IP Addresses, DNS and DHCP','An IP address identifies a device on an IP network. DNS translates domain names into IP addresses. DHCP automatically provides network configuration to devices.',['IPv4 addresses have four decimal sections.','DNS helps locate services by name.','DHCP automates address assignment.','A gateway helps reach other networks.'],'Explain what happens when a student types a website name into a browser. Include DNS and IP addressing.'],
['Network Models and Common Protocols','Network models help explain how communication works. TCP/IP is widely used on modern networks. Common protocols include HTTP, HTTPS, DNS, DHCP and TCP.',['TCP provides reliable delivery.','IP handles addressing and routing.','HTTPS protects web communication.','DNS translates domain names.'],'Prepare a table listing five network protocols and their purposes.'],
['Basic Network Troubleshooting and Safety','Troubleshooting identifies and resolves network problems. A technician checks physical connections, device settings, addresses and services in a logical order.',['Check power and cables first.','Confirm network configuration.','Test one possible cause at a time.','Record changes and results.'],'Write a step-by-step guide for a computer that cannot connect to the internet.']]},
'Cloud Computing':{description:'Understand cloud services, storage, deployment, virtualization and cloud security.',lessons:[
['Introduction to Cloud Computing','Cloud computing provides computing resources such as servers, storage and software over a network. Organizations can use services without owning every physical server.',['Cloud services can scale with demand.','Resources are accessed over networks.','Providers manage underlying infrastructure.','Customers still have security responsibilities.'],'List five examples of cloud services and explain how people use them.'],
['Service Models: IaaS, PaaS and SaaS','Infrastructure as a Service provides virtual computing resources. Platform as a Service provides an environment for building applications. Software as a Service provides ready-to-use applications.',['IaaS offers virtual servers and storage.','PaaS supports application development.','SaaS provides finished software.'],'Classify three familiar online services as IaaS, PaaS or SaaS and explain your choices.'],
['Deployment Models and Cloud Storage','Cloud deployment models include public, private and hybrid cloud. Cloud storage keeps files on remote infrastructure and makes them accessible to authorized users.',['Public cloud uses provider infrastructure.','Private cloud is dedicated to an organization.','Hybrid cloud combines environments.','Access permissions protect stored data.'],'Compare public and private cloud for a school that stores student records.'],
['Virtualization, Containers and Cloud Networking','Virtualization allows multiple virtual machines to run on physical hardware. Containers package applications and their dependencies. Cloud networking connects cloud resources securely.',['Virtual machines run separate operating systems.','Containers package application environments.','Virtual networks connect cloud resources.'],'Draw a diagram showing a physical server hosting two virtual machines.'],
['Cloud Security, Cost and Shared Responsibility','Cloud security includes identity management, encryption, backups, monitoring and secure configuration. Providers and customers share responsibility for protecting cloud systems.',['Protect accounts with strong authentication.','Limit access permissions.','Monitor costs and usage.','Back up important information.'],'Prepare a cloud security checklist for a small school website.']]},
'Web Development':{description:'Learn HTML, CSS, JavaScript, responsive design and how to publish websites.',lessons:[
['How Websites Work','A website is a collection of connected pages and resources. A browser requests information from a web server and displays the returned content.',['Browsers display web pages.','Servers deliver website resources.','HTML provides structure.','CSS controls appearance.','JavaScript adds interaction.'],'Draw a diagram showing a browser requesting a web page from a server.'],
['HTML Structure and Elements','HTML is the standard markup language used to structure web content. Elements describe headings, paragraphs, links, images, lists and forms.',['Use a valid HTML document structure.','Headings organize content.','Links connect pages.','Forms collect user input.'],'Create a simple HTML page containing a title, heading, paragraph, list and link.'],
['CSS Styling and Responsive Design','CSS controls how HTML elements look. It changes colours, spacing, fonts and layouts. Responsive design helps pages work on phones, tablets and computers.',['Use CSS selectors.','Use spacing consistently.','Use flexible layouts.','Test different screen sizes.'],'Style your HTML page with a background colour, heading colour and responsive content area.'],
['JavaScript and Page Interaction','JavaScript makes websites interactive. It can respond to button clicks, validate forms, update content and communicate with online services.',['Variables store information.','Functions organize reusable actions.','Events respond to user activity.','Validate input before processing it.'],'Create a button that displays a welcome message when clicked.'],
['Publishing, Testing and Website Safety','Publishing makes a website available online. Testing checks that links, forms and layouts work correctly. Website safety includes protecting accounts and validating input.',['Test links and forms before publishing.','Use HTTPS where available.','Protect administrator accounts.','Back up website files.'],'Prepare a launch checklist for a small academy website.']]}
};
let currentCourse='',currentLesson=0,currentModule='',currentStudent=null;
function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
window.showPage=id=>{document.querySelectorAll('body > section').forEach(s=>s.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');window.scrollTo(0,0)};
function courseCard(name){return `<div class="card course-card"><span class="badge">${curriculum[name].lessons.length} lessons</span><h3>${safe(name)}</h3><p>${safe(curriculum[name].description)}</p><button class="action gold" onclick="openCourse('${safe(name)}')">View Lessons</button><button class="action" onclick="goRegister('${safe(name)}')">Apply Now</button></div>`}
function renderCourses(){let h=Object.keys(curriculum).map(courseCard).join('');document.getElementById('courseList').innerHTML=h;document.getElementById('homeCourses').innerHTML=h}
window.openCourse=name=>{if(!curriculum[name])return;currentCourse=name;document.getElementById('courseHeading').textContent=name;document.getElementById('courseDescription').textContent=curriculum[name].description;document.getElementById('lessonList').innerHTML=curriculum[name].lessons.map((l,i)=>`<button class="lesson-button" onclick="openLesson(${i})"><strong>Lesson ${i+1}: ${safe(l[0])}</strong><br><span class="small">Open lecture and practical exercise</span></button>`).join('');showPage('courseDetails')};
window.openLesson=i=>{let l=curriculum[currentCourse]?.lessons[i];if(!l)return;currentLesson=i;document.getElementById('lessonContent').innerHTML=`<span class="badge">${safe(currentCourse)}</span><h2>Lesson ${i+1}: ${safe(l[0])}</h2><h3>Lesson Explanation</h3><p>${safe(l[1])}</p><h3>Key Learning Points</h3><ul>${l[2].map(x=>`<li>${safe(x)}</li>`).join('')}</ul><div class="exercise"><h3>Practical Class Exercise</h3><p>${safe(l[3])}</p></div><p class="small">Zacki Stackfix Academy • Keep practising what you learn.</p>`;showPage('lessonPage')};
window.backToCourse=()=>openCourse(currentCourse);window.nextLesson=()=>currentLesson<curriculum[currentCourse].lessons.length-1?openLesson(currentLesson+1):alert('You have completed this course. Well done!');window.previousLesson=()=>currentLesson>0?openLesson(currentLesson-1):alert('This is the first lesson.');window.goRegister=course=>{document.getElementById('regCourse').value=course;showPage('register')};
renderCourses();showPage('home');
function message(id,text,type='notice'){let e=document.getElementById(id);e.className='notice '+(type==='success'?'success':type==='error'?'error':'');e.textContent=text;}

document.getElementById('registerForm').addEventListener('submit',async e=>{e.preventDefault();let fullName=document.getElementById('regName').value.trim(),email=document.getElementById('regEmail').value.trim(),phone=document.getElementById('regPhone').value.trim(),course=document.getElementById('regCourse').value,password=document.getElementById('regPassword').value;try{let cred=await createUserWithEmailAndPassword(auth,email,password);await setDoc(doc(db,'students',cred.user.uid),{fullName,email,phone,course,status:'Pending',createdAt:serverTimestamp()});message('registerMessage','Registration successful. You can now log in.','success');e.target.reset();await signOut(auth)}catch(err){message('registerMessage',err.message,'error')}});

document.getElementById('studentLoginForm').addEventListener('submit',async e=>{e.preventDefault();let email=document.getElementById('studentEmail').value.trim(),password=document.getElementById('studentPassword').value;try{let cred=await signInWithEmailAndPassword(auth,email,password),snap=await getDoc(doc(db,'students',cred.user.uid));if(!snap.exists()){message('studentMessage','No student profile was found for this account. Contact the academy administrator.','error');await signOut(auth);return}currentStudent={...snap.data(),uid:cred.user.uid};let s=currentStudent;let p=document.getElementById('studentProfile');p.classList.remove('hidden');p.innerHTML=`<hr><h3>Welcome, ${safe(s.fullName)}</h3><p><b>Email:</b> ${safe(s.email)}</p><p><b>Phone:</b> ${safe(s.phone)}</p><p><b>Course:</b> ${safe(s.course)}</p><p><b>Registration status:</b> ${safe(s.status)}</p><button class="action gold" id="studentCourseBtn">Open My Course</button><button class="action" id="studentMaterialsBtn">Load Learning Materials</button><div id="studentExtra"></div><button class="action" id="studentLogoutBtn">Logout</button>`;document.getElementById('studentCourseBtn').onclick=()=>openCourse(s.course);document.getElementById('studentMaterialsBtn').onclick=()=>loadStudentMaterials(s.course);document.getElementById('studentLogoutBtn').onclick=async()=>{await signOut(auth);p.classList.add('hidden');document.getElementById('studentLoginForm').reset();message('studentMessage','You have logged out.','success')};message('studentMessage','Login successful.','success');await loadStudentRecords(s.email)}catch(err){message('studentMessage',err.message,'error')}});
async function loadStudentRecords(email){let target=document.getElementById('studentExtra');target.innerHTML='<p>Loading your records...</p>';try{let html='';for(let name of ['enrollments','results']){let q=query(collection(db,name),where('studentEmail','==',email)),ss=await getDocs(q);html+=`<h3>${name[0].toUpperCase()+name.slice(1)}</h3>`;if(ss.empty)html+='<p>No records available yet.</p>';ss.forEach(d=>{html+=`<div class="record">${Object.entries(d.data()).map(([k,v])=>`<b>${safe(k)}:</b> ${safe(v)}<br>`).join('')}</div>`})}target.innerHTML=html}catch(err){target.textContent='Some student records could not be loaded: '+err.message}}
async function loadStudentMaterials(course){let target=document.getElementById('studentExtra');target.innerHTML='<h3>Learning Materials</h3>';try{let ss=await getDocs(query(collection(db,'materials'),where('status','==','Published')));let found=0;ss.forEach(d=>{let m=d.data();if(m.course===course||m.course==='All Courses'){found++;let link=m.resourceUrl?`<p><a href="${safe(m.resourceUrl)}" target="_blank" rel="noopener">Open learning resource</a></p>`:'';target.innerHTML+=`<div class="record"><b>${safe(m.title)}</b><p>${safe(m.description)}</p>${link}</div>`}});if(!found)target.innerHTML+='<p>No extra published materials for this course yet. Your course lectures are available under Open My Course.</p>'}catch(err){target.innerHTML='Could not load materials: '+safe(err.message)}}

document.getElementById('adminLoginForm').addEventListener('submit',async e=>{e.preventDefault();let email=document.getElementById('adminEmail').value.trim(),password=document.getElementById('adminPassword').value;try{let cred=await signInWithEmailAndPassword(auth,email,password),ss=await getDoc(doc(db,'users',cred.user.uid));if(!ss.exists()||ss.data().role!=='Admin'){message('adminMessage','This account is not registered as an administrator.','error');await signOut(auth);return}message('adminMessage','Admin login successful.','success');showPage('dashboard');renderDashboard()}catch(err){message('adminMessage',err.message,'error')}});
function renderDashboard(){document.getElementById('dashboardCards').innerHTML=Object.keys(modules).map(m=>`<button class="module-btn" onclick="openModule('${m}')">${m[0].toUpperCase()+m.slice(1)}</button>`).join('')}
window.openModule=async name=>{currentModule=name;let fields=modules[name];document.getElementById('moduleTitle').textContent=name[0].toUpperCase()+name.slice(1);document.getElementById('moduleFormArea').innerHTML=`<form id="moduleForm"><div class="grid">${fields.map(f=>`<div><label>${safe(f)}</label><input name="${safe(f)}" placeholder="Enter ${safe(f)}"></div>`).join('')}</div><button class="action gold" type="submit">Save Record</button></form>`;document.getElementById('moduleForm').onsubmit=saveModuleRecord;await loadModuleRecords(name)};
async function saveModuleRecord(e){e.preventDefault();let data={};new FormData(e.target).forEach((v,k)=>{if(v.trim())data[k]=v.trim()});if(!Object.keys(data).length){message('moduleMessage','Enter at least one field.','error');return}try{data.createdAt=serverTimestamp();await addDoc(collection(db,currentModule),data);message('moduleMessage','Record saved successfully.','success');e.target.reset();await loadModuleRecords(currentModule)}catch(err){message('moduleMessage',err.message,'error')}}
async function loadModuleRecords(name){let head=document.getElementById('tableHead'),body=document.getElementById('tableBody'),fields=modules[name];head.innerHTML='<tr>'+fields.map(f=>`<th>${safe(f)}</th>`).join('')+'</tr>';body.innerHTML='<tr><td colspan="'+fields.length+'">Loading...</td></tr>';try{let ss=await getDocs(collection(db,name));if(ss.empty){body.innerHTML='<tr><td colspan="'+fields.length+'">No records found.</td></tr>';return}body.innerHTML='';ss.forEach(d=>{let x=d.data();body.innerHTML+='<tr>'+fields.map(f=>`<td>${safe(x[f]||'')}</td>`).join('')+'</tr>'})}catch(err){body.innerHTML='<tr><td colspan="'+fields.length+'">'+safe(err.message)+'</td></tr>'}}
window.adminLogout=async()=>{await signOut(auth);showPage('home')};
</script>
</body>
</html>
