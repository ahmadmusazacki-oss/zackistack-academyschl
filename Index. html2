<style>
:root{--green:#075b36;--gold:#d4af37;--light:#f4f7f5;--dark:#17231c}
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--light);color:var(--dark)}
header{background:var(--green);color:#fff;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}header h1{margin:0;font-size:21px}
nav{display:flex;gap:6px;flex-wrap:wrap}button{border:0;border-radius:6px;padding:11px 14px;cursor:pointer;font-weight:bold}nav button{background:transparent;color:#fff}nav button:hover{background:#ffffff22}
.action{background:var(--green);color:#fff;margin:4px}.gold{background:var(--gold);color:#17231c;margin:4px}button:disabled{opacity:.45;cursor:not-allowed}
main{padding:24px 5%;max-width:1200px;margin:auto}.page{display:none}.page.active{display:block}.hero{background:linear-gradient(120deg,#075b36,#123c2b);color:white;padding:48px 24px;border-radius:12px;text-align:center}.hero h2{font-size:32px}
.card{background:#fff;border-radius:10px;padding:20px;margin:12px 0;box-shadow:0 2px 10px #00000012}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}
input,select,textarea{display:block;width:100%;padding:12px;margin:8px 0 15px;border:1px solid #ccd5ce;border-radius:6px;font-size:15px}label{font-weight:bold}.lesson-item{background:#fff;padding:15px;margin:10px 0;border-radius:8px;border-left:4px solid var(--gold)}.lesson-content{background:#fff;padding:22px;border-radius:10px;line-height:1.7}.lesson-content h3{color:var(--green)}
.message{padding:12px;margin:10px 0;border-radius:6px}.error{background:#ffe5e5;color:#8a1111}.success{background:#e2f5e8;color:#075b36}.small{color:#66736b;font-size:13px}footer{background:#123c2b;color:white;text-align:center;padding:24px;margin-top:35px}.hidden{display:none!important}table{width:100%;border-collapse:collapse;background:white;display:block;overflow-x:auto}td,th{padding:10px;border:1px solid #ddd;text-align:left}a{color:var(--green)}
@media(max-width:600px){header{display:block}nav{margin-top:12px}.hero h2{font-size:25px}main{padding:18px 4%}}
</style>
</head>
