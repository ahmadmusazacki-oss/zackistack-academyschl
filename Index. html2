function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));const page=document.getElementById(id);if(page)page.classList.add('active');window.scrollTo(0,0)}window.showPage=showPage;
function makeAdmissionNumber(uid){return `ZSA-${new Date().getFullYear()}-${String(uid).toUpperCase()}`;}
const certificateCache={};
function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function labelName(s){return s.replace(/([A-Z])/g,' $1').replace(/^./,c=>c.toUpperCase())}
function showMessage(id,msg,type='error'){const el=document.getElementById(id);if(el)el.innerHTML=`<div class="message ${type}">${escapeHtml(msg)}</div>`}
function renderCourses(){const html=courses.map(c=>`<div class="card"><h3>${escapeHtml(c)}</h3><p>Guided lessons and practical skill development.</p><button class="action" onclick="window.openCourse('${c}')">Open Course</button><button class="gold" onclick="window.applyCourse('${c}')">Apply Now</button></div>`).join('');document.getElementById('homeCourses').innerHTML=html;document.getElementById('courseList').innerHTML=html;document.getElementById('regCourse').innerHTML='<option value="">Select a course</option>'+courses.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')}
function openCourse(course){const lessons=curriculum[course];if(!lessons)return;document.getElementById('courseDetailsContent').innerHTML=`<div class="card"><h2>${escapeHtml(course)}</h2><p>${lessons.length} lessons with explanations, key points and exercises.</p><h3>Course Lessons</h3>${lessons.map((l,i)=>`<div class="lesson-item"><strong>Lesson ${i+1}: ${escapeHtml(l[0])}</strong><p>${escapeHtml(l[1].slice(0,155))}...</p><button class="action" onclick="window.openLesson('${course}',${i})">Study Lesson</button></div>`).join('')}<button class="gold" onclick="window.applyCourse('${course}')">Apply for this Course</button></div>`;showPage('courseDetails')}window.openCourse=openCourse;
function applyCourse(course){document.getElementById('regCourse').value=course;showPage('register')}window.applyCourse=applyCourse;
function openLesson(course,index){const lessons=curriculum[course],l=lessons?.[index];if(!l)return;document.getElementById('lessonContent').innerHTML=`<button class="action" onclick="window.openCourse('${course}')">← Back to Lessons</button><div class="lesson-content"><p class="small">${escapeHtml(course)} · Lesson ${index+1} of ${lessons.length}</p><h2>${escapeHtml(l[0])}</h2><h3>Lesson Explanation</h3><p>${escapeHtml(l[1])}</p><h3>Key Learning Points</h3><ul>${l[2].map(p=>`<li>${escapeHtml(p)}</li>`).join('')}</ul><h3>Practical Class Exercise</h3><p>${escapeHtml(l[3])}</p><button class="action" ${index===0?'disabled':''} onclick="window.openLesson('${course}',${index-1})">Previous Lesson</button><button class="gold" ${index===lessons.length-1?'disabled':''} onclick="window.openLesson('${course}',${index+1})">Next Lesson</button></div>`;showPage('lessonPage')}window.openLesson=openLesson;
renderCourses();
// Student registration
 document.getElementById('registerForm').addEventListener('submit',async e=>{e.preventDefault();const fullName=document.getElementById('regName').value.trim(),email=document.getElementById('regEmail').value.trim().toLowerCase(),phone=document.getElementById('regPhone').value.trim(),course=document.getElementById('regCourse').value,password=document.getElementById('regPassword').value;if(!course){showMessage('registerMessage','Please select a course.');return}try{const cred=await createUserWithEmailAndPassword(auth,email,password);const admissionNumber=makeAdmissionNumber(cred.user.uid);await setDoc(doc(db,'students',cred.user.uid),{fullName,email,phone,course,admissionNumber,status:'Pending',createdAt:serverTimestamp()});await signOut(auth);e.target.reset();showMessage('registerMessage',`Registration successful. Your admission number is ${admissionNumber}. You can now log in. Your application is pending approval.`,'success')}catch(err){showMessage('registerMessage',err.message)}});
// Student login and portal
 document.getElementById('studentLoginForm').addEventListener('submit',async e=>{e.preventDefault();const email=document.getElementById('studentEmail').value.trim().toLowerCase(),password=document.getElementById('studentPassword').value;try{const cred=await signInWithEmailAndPassword(auth,email,password),snap=await getDoc(doc(db,'students',cred.user.uid));if(!snap.exists()){await signOut(auth);showMessage('studentMessage','No student record found for this account. Please contact the administrator.');return}const s=snap.data();document.getElementById('studentLoginForm').classList.add('hidden');const portal=document.getElementById('studentPortal');portal.classList.remove('hidden');portal.innerHTML=`<div class="card"><h2>Welcome, ${escapeHtml(s.fullName)}</h2><p><b>Email:</b> ${escapeHtml(s.email)}</p><p><b>Phone:</b> ${escapeHtml(s.phone)}</p><p><b>Admission Number:</b> ${escapeHtml(s.admissionNumber||'Not assigned yet — contact the administrator')}</p><p><b>Course:</b> ${escapeHtml(s.course)}</p><p><b>Status:</b> ${escapeHtml(s.status)}</p><button class="action" onclick="window.openCourse('${s.course}')">Open My Course</button><button class="gold" onclick="window.studentLogout()">Logout</button></div><div class="card"><h3>My Enrollments</h3><div id="myEnrollments">Loading...</div></div><div class="card"><h3>My Results</h3><div id="myResults">Loading...</div></div><div class="card"><h3>My Certificates</h3><div id="myCertificates">Loading...</div></div><div class="card"><h3>Announcements</h3><div id="myAnnouncements">Loading...</div></div><div class="card"><h3>Learning Materials</h3><div id="myMaterials">Loading...</div></div>`;await loadStudentRecords(s.email,cred.user.uid)}catch(err){showMessage('studentMessage',err.message)}});
async function loadStudentRecords(email,studentUid){for(const name of ['enrollments','results']){const target=document.getElementById(name==='enrollments'?'myEnrollments':'myResults');try{const snap=await getDocs(query(collection(db,name),where('studentEmail','==',email)));target.innerHTML=snap.empty?'No records available yet.':snap.docs.map(d=>`<div class="lesson-item">${Object.entries(d.data()).filter(([k])=>k!=='createdAt').map(([k,v])=>`<p><b>${escapeHtml(labelName(k))}:</b> ${escapeHtml(v)}</p>`).join('')}</div>`).join('')}catch(err){target.textContent='Unable to load records.'}}await loadStudentCertificates(studentUid);await loadPublished('announcements','myAnnouncements');await loadPublished('materials','myMaterials')}
async function loadStudentCertificates(studentUid){
 const target=document.getElementById('myCertificates');
 try{
  const snap=await getDocs(query(collection(db,'certificates'),where('studentUid','==',studentUid)));
  if(snap.empty){target.textContent='No certificates have been issued to your account yet.';return;}
  target.innerHTML=snap.docs.map(d=>{const x=d.data();certificateCache[d.id]=x;return `<div class="lesson-item"><b>${escapeHtml(x.course||'Course Certificate')}</b><p>Certificate Number: ${escapeHtml(x.certificateNumber||'')}</p><p>Issue Date: ${escapeHtml(x.issueDate||'')}</p><button class="action" onclick="window.printCertificateById('${d.id}')">View / Print Certificate</button></div>`}).join('');
 }catch(err){target.textContent='Unable to load certificates: '+err.message;}
}
function printCertificate(data){
 const w=window.open('','_blank','width=1000,height=750');
 if(!w){alert('Please allow pop-ups for this website so the certificate can open.');return;}
 const name=escapeHtml(data.studentName||'Student'),course=escapeHtml(data.course||'Course'),date=escapeHtml(data.issueDate||''),number=escapeHtml(data.certificateNumber||''),admission=escapeHtml(data.admissionNumber||'');
 w.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Certificate - ${name}</title><style>@page{size:A4 landscape;margin:12mm}*{box-sizing:border-box}body{font-family:Georgia,serif;color:#17231c;margin:0}.certificate{min-height:180mm;border:12px double #d4af37;padding:30px;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center}.academy{font: bold 26px Arial,sans-serif;letter-spacing:2px;color:#075b36}.tag{font:12px Arial,sans-serif;letter-spacing:4px;color:#9b7b1c;margin-top:8px}h1{font-size:38px;margin:28px 0 12px;color:#17231c}.presented{font-size:18px}.student{font-size:38px;font-weight:bold;color:#075b36;border-bottom:2px solid #d4af37;padding:10px 35px;margin:12px}.course{font-size:28px;color:#9b7b1c;margin:10px}.meta{font:14px Arial,sans-serif;margin-top:12px}.sign{font:13px Arial,sans-serif;margin-top:30px}</style></head><body><div class="certificate"><div class="academy">ZACKI STACKFIX ACADEMY</div><div class="tag">LEARN • BUILD • GROW</div><h1>CERTIFICATE OF COMPLETION</h1><div class="presented">This certificate is proudly presented to</div><div class="student">${name}</div><div class="presented">for completing the course</div><div class="course">${course}</div><div class="meta">Date of Issue: ${date}</div><div class="meta">Certificate Number: ${number}</div><div class="meta">Admission Number: ${admission||'Not recorded'}</div><div class="sign">_____________________________<br>Authorized Academy Signature</div></div></body></html>`);
 w.document.close();w.focus();setTimeout(()=>w.print(),500);
}
window.printCertificateById=id=>{const data=certificateCache[id];if(!data){alert('Certificate details are not loaded. Please refresh and try again.');return;}printCertificate(data);};
async function loadPublished(name,targetId){const target=document.getElementById(targetId);try{const snap=await getDocs(query(collection(db,name),where('status','==','Published')));if(snap.empty){target.textContent='No published records yet.';return}target.innerHTML=snap.docs.map(d=>{const x=d.data();let link='';if(name==='materials'&&typeof x.resourceUrl==='string'){try{const u=new URL(x.resourceUrl);if(u.protocol==='https:')link=`<p><a href="${escapeHtml(u.href)}" target="_blank" rel="noopener noreferrer">Open learning material</a></p>`}catch{}}return `<div class="lesson-item"><b>${escapeHtml(x.title||'Untitled')}</b><p>${escapeHtml(x.message||x.description||'')}</p>${link}</div>`}).join('')}catch(err){target.textContent='Unable to load published items.'}}
async function studentLogout(){await signOut(auth);document.getElementById('studentPortal').classList.add('hidden');document.getElementById('studentLoginForm').classList.remove('hidden');document.getElementById('studentLoginForm').reset();showPage('studentLogin')}window.studentLogout=studentLogout;
// Administrator login: account must have users/{uid} with role exactly "Admin".
document.getElementById('adminLoginForm').addEventListener('submit',async e=>{e.preventDefault();const email=document.getElementById('adminEmail').value.trim(),password=document.getElementById('adminPassword').value;try{const cred=await signInWithEmailAndPassword(auth,email,password),snap=await getDoc(doc(db,'users',cred.user.uid));if(!snap.exists()||snap.data().role!=='Admin'){await signOut(auth);showMessage('adminMessage','Administrator access denied.');return}e.target.reset();showDashboard();showPage('dashboard')}catch(err){showMessage('adminMessage',err.message)}});
function showDashboard(){const buttons=Object.keys(modules).map(n=>`<button class="action" onclick="window.openModule('${n}')">${escapeHtml(labelName(n))}</button>`).join('');document.getElementById('dashboardContent').innerHTML=`<div class="card"><h3>Administrator Control Panel</h3><p>Select a module to manage academy records.</p>${buttons}</div><div id="moduleArea" class="card"><h3>Welcome Administrator</h3><p>Choose a module above.</p></div>`}
async function openModule(name){
 if(!modules[name])return;
 currentModule=name;
 if(name==='certificates'){await openCertificateIssuer();return;}
 const fields=modules[name];
 const assignButton=name==='students'?'<button class="gold" type="button" onclick="window.assignMissingAdmissionNumbers()">Assign Missing Admission Numbers to Existing Students</button><p class="small">This only fills admission numbers that are currently missing.</p>':'';
 document.getElementById('moduleArea').innerHTML=`<h3>${escapeHtml(labelName(name))} Management</h3>${assignButton}<form id="moduleForm">${fields.map(f=>`<label>${escapeHtml(labelName(f))}</label><input name="${escapeHtml(f)}" ${['date','dateOfBirth','paymentDate','issueDate','enrollmentDate'].includes(f)?'type="date"':''} ${f==='resourceUrl'?'type="url"':''} required>`).join('')}<button class="action" type="submit">Save Record</button></form><div id="moduleMessage"></div><hr><h3>Saved Records</h3><div id="recordList">Loading...</div>`;
 document.getElementById('moduleForm').addEventListener('submit',saveModuleRecord);
 await loadModuleRecords(name);
}window.openModule=openModule;

window.assignMissingAdmissionNumbers=async()=>{
 const target=document.getElementById('moduleMessage');
 try{
  const snap=await getDocs(collection(db,'students'));let count=0;
  for(const studentDoc of snap.docs){
   if(!studentDoc.data().admissionNumber){
    await updateDoc(doc(db,'students',studentDoc.id),{admissionNumber:makeAdmissionNumber(studentDoc.id)});
    count++;
   }
  }
  showMessage('moduleMessage',count?`${count} missing admission number(s) assigned successfully.`:'Every student already has an admission number.','success');
  await loadModuleRecords('students');
 }catch(err){showMessage('moduleMessage','Unable to assign admission numbers: '+err.message);}
};

async function openCertificateIssuer(){
 currentModule='certificates';
 document.getElementById('moduleArea').innerHTML=`<h3>Issue a Student Certificate</h3><p>Select a registered student, choose the course and issue date, then issue the certificate. A unique certificate number will be generated automatically.</p><form id="certificateForm"><label>Student</label><select id="certificateStudent" required><option value="">Loading students...</option></select><label>Course</label><select id="certificateCourse" required>${courses.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')}</select><label>Issue Date</label><input id="certificateDate" type="date" required><button class="action" type="submit">Issue Certificate</button></form><div id="moduleMessage"></div><hr><h3>Issued Certificates</h3><div id="recordList">Loading...</div>`;
 try{
  const snap=await getDocs(collection(db,'students'));const select=document.getElementById('certificateStudent');
  select.innerHTML='<option value="">Choose a student</option>';
  snap.docs.forEach(d=>{const x=d.data();const option=document.createElement('option');option.value=d.id;option.textContent=`${x.fullName||'Unnamed student'} — ${x.admissionNumber||'No admission number'}`;option.dataset.course=x.course||'';select.appendChild(option);});
  select.addEventListener('change',()=>{const chosen=select.options[select.selectedIndex];if(chosen?.dataset.course&&courses.includes(chosen.dataset.course))document.getElementById('certificateCourse').value=chosen.dataset.course;});
  document.getElementById('certificateDate').value=new Date().toISOString().slice(0,10);
  document.getElementById('certificateForm').addEventListener('submit',issueCertificate);
  await loadModuleRecords('certificates');
 }catch(err){showMessage('moduleMessage','Unable to load student list: '+err.message);}
}

async function issueCertificate(e){
 e.preventDefault();const uid=document.getElementById('certificateStudent').value;
 if(!uid){showMessage('moduleMessage','Please choose a student.');return;}
 try{
  const studentSnap=await getDoc(doc(db,'students',uid));
  if(!studentSnap.exists())throw new Error('The selected student record was not found.');
  const student=studentSnap.data(),certificateRef=doc(collection(db,'certificates'));
  const certificateNumber='ZSA-CERT-'+certificateRef.id.toUpperCase();
  const record={studentUid:uid,studentName:student.fullName||'',studentEmail:student.email||'',admissionNumber:student.admissionNumber||makeAdmissionNumber(uid),course:document.getElementById('certificateCourse').value,certificateNumber,issueDate:document.getElementById('certificateDate').value,status:'Issued',issuedBy:auth.currentUser.uid,createdAt:serverTimestamp()};
  await setDoc(certificateRef,record);certificateCache[certificateRef.id]=record;
  showMessage('moduleMessage','Certificate issued successfully. Number: '+certificateNumber,'success');
  await loadModuleRecords('certificates');
 }catch(err){showMessage('moduleMessage','Certificate could not be issued: '+err.message);}
}
async function saveModuleRecord(e){e.preventDefault();const record=Object.fromEntries(new FormData(e.target).entries());for(const k in record)record[k]=record[k].trim();try{await addDoc(collection(db,currentModule),{...record,createdAt:serverTimestamp()});e.target.reset();showMessage('moduleMessage','Record saved successfully.','success');await loadModuleRecords(currentModule)}catch(err){showMessage('moduleMessage',err.message)}}
async function loadModuleRecords(name){
 const target=document.getElementById('recordList');if(!target)return;
 try{
  const snap=await getDocs(collection(db,name));
  if(snap.empty){target.textContent='No records saved yet.';return;}
  target.innerHTML=snap.docs.map(d=>{
   const data=d.data();
   if(name==='certificates')certificateCache[d.id]=data;
   const details=Object.entries(data).filter(([k])=>!['createdAt','issuedBy','studentUid'].includes(k)).map(([k,v])=>`<p><b>${escapeHtml(labelName(k))}:</b> ${escapeHtml(v)}</p>`).join('');
   const printButton=name==='certificates'?`<button class="action" onclick="window.printCertificateById('${d.id}')">View / Print Certificate</button>`:'';
   return `<div class="lesson-item">${details}${printButton}</div>`;
  }).join('');
 }catch(err){target.textContent='Unable to load records: '+err.message;}
}
async function logout(){await signOut(auth);showPage('home')}window.logout=logout;
</script>
